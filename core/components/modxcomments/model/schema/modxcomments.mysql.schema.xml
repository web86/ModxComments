<?xml version="1.0" encoding="UTF-8"?>
<model package="modxcomments" baseClass="xPDOObject" platform="mysql" defaultEngine="InnoDB" version="1.1">
    <object class="ModxCommentsComment" table="modxcomments_comments" extends="xPDOSimpleObject">
        <field key="resource_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="context_key" dbtype="varchar" precision="100" phptype="string" null="false" default="web" />
        <field key="parent_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="thread_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="depth" dbtype="tinyint" precision="3" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="path" dbtype="varchar" precision="255" phptype="string" null="false" default="" />
        <field key="user_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="author_name" dbtype="varchar" precision="190" phptype="string" null="false" default="" />
        <field key="author_email" dbtype="varchar" precision="254" phptype="string" null="false" default="" />
        <field key="content" dbtype="text" phptype="string" null="false" />
        <field key="content_html" dbtype="text" phptype="string" null="false" />
        <field key="content_hash" dbtype="char" precision="64" phptype="string" null="false" default="" />
        <field key="status" dbtype="varchar" precision="32" phptype="string" null="false" default="published" />
        <field key="createdon" dbtype="datetime" phptype="datetime" null="false" />
        <field key="editedon" dbtype="datetime" phptype="datetime" null="true" default="NULL" />
        <field key="deletedon" dbtype="datetime" phptype="datetime" null="true" default="NULL" />
        <field key="reply_notifiedon" dbtype="datetime" phptype="datetime" null="true" default="NULL" />
        <field key="ip_hash" dbtype="char" precision="64" phptype="string" null="false" default="" />
        <field key="user_agent_hash" dbtype="char" precision="64" phptype="string" null="false" default="" />

        <index alias="resource_context_status" name="resource_context_status" primary="false" unique="false" type="BTREE">
            <column key="resource_id" collation="A" null="false" />
            <column key="context_key" collation="A" null="false" />
            <column key="status" collation="A" null="false" />
        </index>
        <index alias="parent_id" name="parent_id" primary="false" unique="false" type="BTREE">
            <column key="parent_id" collation="A" null="false" />
        </index>
        <index alias="thread_path" name="thread_path" primary="false" unique="false" type="BTREE">
            <column key="thread_id" collation="A" null="false" />
            <column key="path" collation="A" null="false" />
        </index>
        <index alias="user_id" name="user_id" primary="false" unique="false" type="BTREE">
            <column key="user_id" collation="A" null="false" />
        </index>
        <index alias="ip_created" name="ip_created" primary="false" unique="false" type="BTREE">
            <column key="ip_hash" collation="A" null="false" />
            <column key="createdon" collation="A" null="false" />
        </index>

        <aggregate alias="Resource" class="modResource" local="resource_id" foreign="id" cardinality="one" owner="foreign" />
        <aggregate alias="User" class="modUser" local="user_id" foreign="id" cardinality="one" owner="foreign" />
        <aggregate alias="Parent" class="ModxCommentsComment" local="parent_id" foreign="id" cardinality="one" owner="foreign" />
        <composite alias="Votes" class="ModxCommentsVote" local="id" foreign="comment_id" cardinality="many" owner="local" />
    </object>

    <object class="ModxCommentsVote" table="modxcomments_votes" extends="xPDOSimpleObject">
        <field key="comment_id" dbtype="int" precision="10" attributes="unsigned" phptype="integer" null="false" default="0" />
        <field key="voter_hash" dbtype="char" precision="64" phptype="string" null="false" default="" />
        <field key="value" dbtype="tinyint" precision="2" phptype="integer" null="false" default="1" />
        <field key="createdon" dbtype="datetime" phptype="datetime" null="false" />

        <index alias="comment_voter" name="comment_voter" primary="false" unique="true" type="BTREE">
            <column key="comment_id" collation="A" null="false" />
            <column key="voter_hash" collation="A" null="false" />
        </index>
        <index alias="comment_value" name="comment_value" primary="false" unique="false" type="BTREE">
            <column key="comment_id" collation="A" null="false" />
            <column key="value" collation="A" null="false" />
        </index>

        <aggregate alias="Comment" class="ModxCommentsComment" local="comment_id" foreign="id" cardinality="one" owner="foreign" />
    </object>
</model>
